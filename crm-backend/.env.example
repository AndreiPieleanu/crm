# Copy this file to .env (never commit .env) and replace every value.
# Generate random values with the command in README.md.

# Postgres superuser, used only by the local Docker container.
CRM_DB_ADMIN_PASSWORD=change-me

# Owner of the schema, used only by Flyway migrations.
CRM_DB_OWNER_PASSWORD=change-me

# Restricted role used by the running app.
CRM_DB_APP_PASSWORD=change-me

# Key that signs login tokens: base64, at least 32 bytes.
CRM_JWT_SECRET=change-me

# Comma-separated list of frontend addresses allowed to call the API.
CRM_CORS_ALLOWED_ORIGINS=http://localhost:5173
